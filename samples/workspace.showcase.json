      },
      "l_diagrams_note": {
        "id": "l_diagrams_note",
        "parent": "l_diagrams",
        "name": "Three diagrams. Open Classes: Part extends Unit, and a link named unit. Open Lanes: two columns, a step in each, and a line between them. Open Messages: a self message on Self, an empty lifeline whose header refers to nothing, and a phase named Now.",
        "type": "note",
        "alias": 12,
        "h": 96,
        "order": 1,
        "w": 528
      },
      "l_faces": {
        "id": "l_faces",
        "parent": "main",
        "name": "Faces",
        "type": "def_large",
        "alias": 4,
        "order": 2
      },
      "l_faces_note": {
        "id": "l_faces_note",
        "parent": "l_faces",
        "name": "The large faces, on a layer that asks for them: a document, a table with its body under it, a picture; then a document without its name, and one its definition sizes. A plain block names no face, so its name is the whole card.",
        "type": "note",
        "alias": 3,
        "h": 72,
        "order": 1,
        "w": 648
      },
      "l_hold": {
        "id": "l_hold",
        "parent": "main",
        "name": "Holders",
        "alias": 49,
        "order": 6
      },
      "l_hold_note": {
        "id": "l_hold_note",
        "parent": "l_hold",
        "name": "A group gathers blocks where they sit, and nests. A grid seats blocks in cells: its top row and left column head the lines; a merge spans cells. Its definition, Table, lists every trait it keeps, has head among them. Select the grid and press Enter to see its cells.",
        "type": "note",
        "alias": 8,
        "h": 96,
        "order": 1,
        "w": 648
      },
      "l_model": {
        "id": "l_model",
