        "name": "A reference stands for something drawn elsewhere: a block on the cards layer, a definition, or something since deleted.",
        "type": "note",
        "alias": 9,
        "h": 72,
        "order": 1,
        "w": 528
      },
      "l_rel": {
        "id": "l_rel",
        "parent": "main",
        "name": "Relations",
        "alias": 15,
        "order": 4
      },
      "l_rel_note": {
        "id": "l_rel_note",
        "parent": "l_rel",
        "name": "Each direction, a name, arrows and a tie; then a run past a third block, a pair related both ways as one line, two runs that cross, a pair close together, and a hub whose lines share a trunk and fan out. Lines leave the middle of a face and go round cards; a tie runs straight from card to card.",
        "type": "note",
        "alias": 5,
        "h": 96,
        "order": 1,
        "w": 648
      },
