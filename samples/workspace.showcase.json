        "alias": 64,
        "order": 8
      },
      "l_model_note": {
        "id": "l_model_note",
        "parent": "l_model",
        "name": "The entity-relation package's entities as stand-ins: each attribute typed by another entity draws a link.",
        "type": "note",
        "alias": 10,
        "h": 72,
        "order": 1,
        "w": 528
      },
      "l_ports": {
        "id": "l_ports",
        "parent": "main",
        "name": "Interfaces",
        "alias": 44,
        "order": 5
      },
      "l_ports_note": {
        "id": "l_ports_note",
        "parent": "l_ports",
        "name": "Ports placed on each side of Pump, flowing in, out, both or neither; Pump's top port is placed in the middle of a face no line meets; Tank and Valve's ports place themselves, in a face's middle unless a line's anchor holds it. Lines to the room meet its wall straight across: Gauge's line to the room itself, and Drain, the room's own port, placing itself.",
        "type": "note",
        "alias": 7,
        "h": 120,
        "order": 1,
        "w": 528
      },
      "l_refs": {
        "id": "l_refs",
