      "l_defs_note": {
        "id": "l_defs_note",
        "parent": "l_defs",
        "name": "A chain: Pump extends Machine, Big pump extends Pump. Machine draws in the secondary family; Pump carries the rotating tag, filed in the workspace's tags folder. Each stand-in draws the definition as its usages do, with everything it inherits; the usages below answer it. Machine declares a power port that Pump and Big pump inherit. Open a stand-in for its definition view: Big pump shows everything it is, what it reads from its chain dimmed. Compressor drives Feed pump by a relation definition, drives: select the line and open its definition from the tray, or find it under workspace › relations.",
        "type": "note",
        "alias": 4,
        "h": 144,
        "order": 1,
