        "id": "dec_idempotency",
        "parent": "story_platform",
        "name": "Charge once",
        "type": "architecture.decision",
        "alias": 14,
        "body": "\r\nCheckout retries the same request. The order service treats a repeated checkout key as the order it already created, so a retry never charges twice.\r\n",
