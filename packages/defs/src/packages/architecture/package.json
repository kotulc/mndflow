{
  "schema": "1.0",
  "id": "architecture",
  "graph": {
    "root": "architecture",
    "blocks": {
      "architecture": { "id": "architecture", "parent": null, "name": "architecture" },
      "patterns": { "id": "patterns", "parent": "architecture", "name": "patterns",
                    "type": "folder", "tree": "definitions", "order": 1 },

      "layered_service": { "id": "layered_service", "parent": "patterns",
        "name": "layered service", "type": "service", "def": {}, "order": 1,
        "body": "Use when one service owns its rules and its store, and every request should meet them in the same order." },
      "n_layered_service": { "id": "n_layered_service", "parent": "layered_service",
        "name": "Requests enter at the API, rules live in one layer, storage is reached only through the repository.",
        "type": "note", "order": 1, "w": 288, "h": 96 },
      "ls_api": { "id": "ls_api", "parent": "layered_service", "name": "API",
        "type": "component", "order": 2,
        "body": "Accepts a request and hands it to the domain logic." },
      "ls_logic": { "id": "ls_logic", "parent": "layered_service", "name": "Domain logic",
        "type": "component", "order": 3,
        "body": "Applies the rules. It does not talk to the store." },
      "ls_repo": { "id": "ls_repo", "parent": "layered_service", "name": "Repository",
        "type": "component", "order": 4,
        "body": "Reads and writes the store for the domain logic." },
      "ls_store": { "id": "ls_store", "parent": "layered_service", "name": "Store",
        "type": "database", "order": 5,
        "body": "Holds the service's state." },
      "ls_requests": { "id": "ls_requests", "parent": "layered_service", "name": "requests",
        "type": "interface", "flow": "in", "order": 6 },
      "n_ls_api": { "id": "n_ls_api", "parent": "layered_service", "type": "note", "order": 7,
        "name": "The only way in: it accepts the request and does no work of its own.",
        "w": 216, "h": 72 },
      "n_ls_logic": { "id": "n_ls_logic", "parent": "layered_service", "type": "note", "order": 8,
        "name": "The rules live here, and nowhere else in the service.",
        "w": 216, "h": 72 },
      "n_ls_repo": { "id": "n_ls_repo", "parent": "layered_service", "type": "note", "order": 9,
        "name": "Reads and writes the store; nothing else touches it.",
        "w": 216, "h": 72 },
      "n_ls_store": { "id": "n_ls_store", "parent": "layered_service", "type": "note", "order": 10,
        "name": "The service's state, reached only through the repository.",
        "w": 216, "h": 72 },

      "outbox_service": { "id": "outbox_service", "parent": "patterns",
        "name": "outbox service", "type": "service", "def": {}, "order": 2,
        "body": "Use when a state change must announce itself, and neither the change nor the announcement may be lost." },
      "n_outbox_service": { "id": "n_outbox_service", "parent": "outbox_service",
        "name": "A state change and the event announcing it are written together, so neither is lost.",
        "type": "note", "order": 1, "w": 288, "h": 96 },
      "ob_api": { "id": "ob_api", "parent": "outbox_service", "name": "API",
        "type": "component", "order": 2, "body": "Accepts a request and hands it to the domain logic." },
      "ob_logic": { "id": "ob_logic", "parent": "outbox_service", "name": "Domain logic",
        "type": "component", "order": 3,
        "body": "Applies the rules and writes the announcement in the same transaction." },
      "ob_repo": { "id": "ob_repo", "parent": "outbox_service", "name": "Repository",
        "type": "component", "order": 4, "body": "Reads and writes the store for the domain logic." },
      "ob_store": { "id": "ob_store", "parent": "outbox_service", "name": "Store",
        "type": "database", "order": 5, "body": "Holds the service's state." },
      "ob_outbox": { "id": "ob_outbox", "parent": "outbox_service", "name": "Outbox",
        "type": "database", "order": 6,
        "body": "Holds the events written in the same transaction as the state change." },
      "ob_relay": { "id": "ob_relay", "parent": "outbox_service", "name": "Outbox relay",
        "type": "component", "order": 7,
        "body": "Publishes each outbox event, and retries until it has." },
      "ob_requests": { "id": "ob_requests", "parent": "outbox_service", "name": "requests",
        "type": "interface", "flow": "in", "order": 8 },
      "ob_events": { "id": "ob_events", "parent": "outbox_service", "name": "events",
        "type": "interface", "flow": "out", "order": 9 },
      "n_ob_api": { "id": "n_ob_api", "parent": "outbox_service", "type": "note", "order": 10,
        "name": "The only way in: it accepts the request and does no work of its own.",
        "w": 216, "h": 72 },
      "n_ob_logic": { "id": "n_ob_logic", "parent": "outbox_service", "type": "note", "order": 11,
        "name": "Writes the state change and the event in one transaction.",
        "w": 216, "h": 72 },
      "n_ob_repo": { "id": "n_ob_repo", "parent": "outbox_service", "type": "note", "order": 12,
        "name": "Reads and writes the store; nothing else touches it.",
        "w": 216, "h": 72 },
      "n_ob_store": { "id": "n_ob_store", "parent": "outbox_service", "type": "note", "order": 13,
        "name": "The service's state, reached only through the repository.",
        "w": 216, "h": 72 },
      "n_ob_outbox": { "id": "n_ob_outbox", "parent": "outbox_service", "type": "note", "order": 14,
        "name": "The events, written beside the state they announce.",
        "w": 216, "h": 72 },
      "n_ob_relay": { "id": "n_ob_relay", "parent": "outbox_service", "type": "note", "order": 15,
        "name": "Polls the outbox and publishes each event at least once.",
        "w": 216, "h": 72 },

      "adapter": { "id": "adapter", "parent": "patterns",
        "name": "adapter", "type": "service", "def": {}, "order": 3,
        "body": "Use when an outside system must be reached without its model leaking into ours." },
      "n_adapter": { "id": "n_adapter", "parent": "adapter",
        "name": "Keeps an outside system's model out of ours: everything crossing is translated in one place.",
        "type": "note", "order": 1, "w": 288, "h": 96 },
      "ad_port": { "id": "ad_port", "parent": "adapter", "name": "Inbound API",
        "type": "component", "order": 2, "body": "Accepts our model's request." },
      "ad_translate": { "id": "ad_translate", "parent": "adapter", "name": "Translator",
        "type": "component", "order": 3, "body": "Maps the outside model to ours and back." },
      "ad_client": { "id": "ad_client", "parent": "adapter", "name": "Client",
        "type": "component", "order": 4, "body": "Speaks the outside system's protocol." },
      "ad_in": { "id": "ad_in", "parent": "adapter", "name": "in",
        "type": "interface", "flow": "in", "order": 5 },
      "ad_out": { "id": "ad_out", "parent": "adapter", "name": "out",
        "type": "interface", "flow": "out", "order": 6 },
      "n_ad_port": { "id": "n_ad_port", "parent": "adapter", "type": "note", "order": 7,
        "name": "Accepts a request already in our model.",
        "w": 216, "h": 72 },
      "n_ad_translate": { "id": "n_ad_translate", "parent": "adapter", "type": "note", "order": 8,
        "name": "Maps the outside model to ours and back.",
        "w": 216, "h": 72 },
      "n_ad_client": { "id": "n_ad_client", "parent": "adapter", "type": "note", "order": 9,
        "name": "The only part that speaks the outside protocol.",
        "w": 216, "h": 72 }
    },
    "edges": {
      "t_ls_api": { "id": "t_ls_api", "from": "n_ls_api", "to": "ls_api", "type": "tie" },
      "t_ls_logic": { "id": "t_ls_logic", "from": "n_ls_logic", "to": "ls_logic", "type": "tie" },
      "t_ls_repo": { "id": "t_ls_repo", "from": "n_ls_repo", "to": "ls_repo", "type": "tie" },
      "t_ls_store": { "id": "t_ls_store", "from": "n_ls_store", "to": "ls_store", "type": "tie" },
      "ls_api_logic": { "id": "ls_api_logic", "from": "ls_api", "to": "ls_logic", "type": "calls" },
      "ls_logic_repo": { "id": "ls_logic_repo", "from": "ls_logic", "to": "ls_repo", "type": "calls" },
      "ls_repo_store": { "id": "ls_repo_store", "from": "ls_repo", "to": "ls_store", "type": "reads" },
      "ls_in": { "id": "ls_in", "from": "ls_requests", "to": "ls_api", "type": "calls" },

      "t_ob_api": { "id": "t_ob_api", "from": "n_ob_api", "to": "ob_api", "type": "tie" },
      "t_ob_logic": { "id": "t_ob_logic", "from": "n_ob_logic", "to": "ob_logic", "type": "tie" },
      "t_ob_repo": { "id": "t_ob_repo", "from": "n_ob_repo", "to": "ob_repo", "type": "tie" },
      "t_ob_store": { "id": "t_ob_store", "from": "n_ob_store", "to": "ob_store", "type": "tie" },
      "t_ob_outbox": { "id": "t_ob_outbox", "from": "n_ob_outbox", "to": "ob_outbox", "type": "tie" },
      "t_ob_relay": { "id": "t_ob_relay", "from": "n_ob_relay", "to": "ob_relay", "type": "tie" },
      "ob_api_logic": { "id": "ob_api_logic", "from": "ob_api", "to": "ob_logic", "type": "calls" },
      "ob_logic_repo": { "id": "ob_logic_repo", "from": "ob_logic", "to": "ob_repo", "type": "calls" },
      "ob_repo_store": { "id": "ob_repo_store", "from": "ob_repo", "to": "ob_store", "type": "reads" },
      "ob_logic_outbox": { "id": "ob_logic_outbox", "from": "ob_logic", "to": "ob_outbox",
        "type": "reads", "name": "same transaction" },
      "ob_relay_outbox": { "id": "ob_relay_outbox", "from": "ob_relay", "to": "ob_outbox", "type": "reads" },
      "ob_relay_events": { "id": "ob_relay_events", "from": "ob_relay", "to": "ob_events", "type": "publishes" },
      "ob_in": { "id": "ob_in", "from": "ob_requests", "to": "ob_api", "type": "calls" },

      "t_ad_port": { "id": "t_ad_port", "from": "n_ad_port", "to": "ad_port", "type": "tie" },
      "t_ad_translate": { "id": "t_ad_translate", "from": "n_ad_translate", "to": "ad_translate", "type": "tie" },
      "t_ad_client": { "id": "t_ad_client", "from": "n_ad_client", "to": "ad_client", "type": "tie" },
      "ad_port_translate": { "id": "ad_port_translate", "from": "ad_port", "to": "ad_translate", "type": "calls" },
      "ad_translate_client": { "id": "ad_translate_client", "from": "ad_translate", "to": "ad_client", "type": "calls" },
      "ad_client_out": { "id": "ad_client_out", "from": "ad_client", "to": "ad_out", "type": "integrates" },
      "ad_enter": { "id": "ad_enter", "from": "ad_in", "to": "ad_port", "type": "calls" }
    }
  }
}
