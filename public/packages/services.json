      "services.yaml.patterns.api-gateway": {
        "id": "services.yaml.patterns.api-gateway",
        "parent": "services.dir.patterns",
        "name": "API gateway",
        "type": "services.service",
        "def": {},
        "body": "Use when many clients reach many services and each request should be checked once, at one way in.",
        "order": 2,
        "ports": [
          {
            "id": "services.yaml.patterns.api-gateway.port.requests",
            "name": "requests",
            "flow": "in",
            "side": "left",
            "at": 0.5,
            "type": "services.interface.http"
          },
          {
            "id": "services.yaml.patterns.api-gateway.port.routes",
            "name": "routes",
            "flow": "out",
            "side": "right",
            "at": 0.5,
            "type": "services.interface.http"
          },
          {
            "id": "services.yaml.patterns.api-gateway.port.admin",
            "name": "admin",
            "side": "bottom",
            "at": 0.5,
            "type": "services.interface.http"
          }
        ],
        "source": "patterns/api-gateway.yaml"
      },
      "services.yaml.patterns.api-gateway:auth": {
        "id": "services.yaml.patterns.api-gateway:auth",
        "parent": "services.yaml.patterns.api-gateway",
        "name": "Auth",
        "type": "services.component",
        "alias": 4,
        "order": 2
      },
      "services.yaml.patterns.api-gateway:note-1": {
        "id": "services.yaml.patterns.api-gateway:note-1",
        "parent": "services.yaml.patterns.api-gateway",
        "name": "One way in: every request is authenticated, held to its quota, then routed to the service that owns it.",
        "type": "note",
        "alias": 5,
        "order": 1
      },
      "services.yaml.patterns.api-gateway:note-2": {
        "id": "services.yaml.patterns.api-gateway:note-2",
        "parent": "services.yaml.patterns.api-gateway",
        "name": "Checks who is calling before anything else runs.",
        "type": "note",
        "alias": 6,
        "order": 3
      },
      "services.yaml.patterns.api-gateway:note-3": {
        "id": "services.yaml.patterns.api-gateway:note-3",
        "parent": "services.yaml.patterns.api-gateway",
        "name": "Turns away a caller over its quota.",
        "type": "note",
        "alias": 7,
        "order": 5
      },
      "services.yaml.patterns.api-gateway:note-4": {
        "id": "services.yaml.patterns.api-gateway:note-4",
        "parent": "services.yaml.patterns.api-gateway",
        "name": "Sends each request to the service that owns its path.",
        "type": "note",
        "alias": 8,
        "order": 7
      },
      "services.yaml.patterns.api-gateway:rate-limit": {
        "id": "services.yaml.patterns.api-gateway:rate-limit",
