        "id": "services.yaml.patterns.anti-corruption-layer:note-1",
        "parent": "services.yaml.patterns.anti-corruption-layer",
        "name": "Keeps an outside model out of ours. Everything crossing is translated in one place.",
        "type": "note",
        "alias": 1,
        "order": 1
      },
      "services.yaml.patterns.anti-corruption-layer:note-2": {
        "id": "services.yaml.patterns.anti-corruption-layer:note-2",
        "parent": "services.yaml.patterns.anti-corruption-layer",
        "name": "Accepts a request already in our model.",
        "type": "note",
        "alias": 2,
        "order": 3
      },
      "services.yaml.patterns.anti-corruption-layer:note-3": {
        "id": "services.yaml.patterns.anti-corruption-layer:note-3",
        "parent": "services.yaml.patterns.anti-corruption-layer",
        "name": "Maps the outside model to ours and back.",
        "type": "note",
        "alias": 3,
        "order": 5
      },
      "services.yaml.patterns.anti-corruption-layer:note-4": {
        "id": "services.yaml.patterns.anti-corruption-layer:note-4",
        "parent": "services.yaml.patterns.anti-corruption-layer",
        "name": "The only part that speaks the outside protocol.",
