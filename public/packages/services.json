        "ports": [
          {
            "id": "services.yaml.patterns.circuit-breaker.port.in",
            "name": "in",
            "flow": "in",
            "type": "services.interface.http"
          },
          {
            "id": "services.yaml.patterns.circuit-breaker.port.remote",
            "name": "remote",
            "flow": "out",
            "type": "services.interface.http"
          }
        ],
        "source": "patterns/circuit-breaker.yaml"
      },
      "services.yaml.patterns.circuit-breaker:breaker": {
        "id": "services.yaml.patterns.circuit-breaker:breaker",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Breaker",
        "type": "services.component",
        "alias": 8,
        "order": 3
      },
      "services.yaml.patterns.circuit-breaker:caller": {
        "id": "services.yaml.patterns.circuit-breaker:caller",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Caller",
        "type": "services.component",
        "alias": 7,
        "order": 2
      },
      "services.yaml.patterns.circuit-breaker:fallback": {
        "id": "services.yaml.patterns.circuit-breaker:fallback",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Fallback",
        "type": "services.component",
        "alias": 9,
        "order": 5
      },
      "services.yaml.patterns.circuit-breaker:note-1": {
        "id": "services.yaml.patterns.circuit-breaker:note-1",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Calls pass while the remote answers. After repeated failures the breaker opens and the fallback answers until a trial call succeeds.",
        "type": "note",
        "alias": 9,
        "order": 1
      },
      "services.yaml.patterns.circuit-breaker:note-2": {
        "id": "services.yaml.patterns.circuit-breaker:note-2",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Counts failures. Closed, it passes calls; open, it fails fast.",
        "type": "note",
        "alias": 10,
        "order": 4
      },
      "services.yaml.patterns.circuit-breaker:note-3": {
        "id": "services.yaml.patterns.circuit-breaker:note-3",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Answers while the breaker is open.",
        "type": "note",
        "alias": 11,
        "order": 6
      },
