          },
          {
            "id": "services.yaml.patterns.circuit-breaker.port.remote",
            "name": "remote",
            "flow": "out",
            "type": "services.interface.http"
          }
        ],
        "source": "patterns/circuit-breaker.yaml"
      },
      "services.yaml.patterns.circuit-breaker.1": {
        "id": "services.yaml.patterns.circuit-breaker.1",
        "parent": "services.yaml.patterns.circuit-breaker",
        "name": "Calls pass while the remote answers. After repeated failures the breaker opens and the fallback answers until a trial call succeeds.",
        "type": "note",
        "alias": 9,
        "order": 1
      },
      "services.yaml.patterns.circuit-breaker.2": {
        "id": "services.yaml.patterns.circuit-breaker.2",
