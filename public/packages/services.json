        "name": "Router",
        "type": "services.component",
        "alias": 6,
        "order": 6
      },
      "services.yaml.patterns.circuit-breaker": {
        "id": "services.yaml.patterns.circuit-breaker",
        "parent": "services.dir.patterns",
        "name": "Circuit breaker",
        "type": "services.component",
        "def": {},
        "body": "Use when a remote call can hang or fail, and a failing dependency must not take its callers down with it.",
