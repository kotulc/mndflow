        "id": "services.yaml.patterns.anti-corruption-layer.1",
        "parent": "services.yaml.patterns.anti-corruption-layer",
        "name": "Keeps an outside model out of ours. Everything crossing is translated in one place.",
        "type": "note",
        "alias": 1,
        "order": 1
