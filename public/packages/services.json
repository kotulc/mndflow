        "ports": [
          {
            "id": "services.yaml.patterns.anti-corruption-layer.port.in",
            "name": "in",
            "flow": "in",
            "type": "services.interface.http"
          },
          {
            "id": "services.yaml.patterns.anti-corruption-layer.port.out",
            "name": "out",
            "flow": "out",
            "type": "services.interface.http"
          }
        ],
        "source": "patterns/anti-corruption-layer.yaml"
      },
      "services.yaml.patterns.anti-corruption-layer:client": {
        "id": "services.yaml.patterns.anti-corruption-layer:client",
