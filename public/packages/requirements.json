{
  "schema": "2.0",
  "id": "requirements",
  "graph": {
    "root": "ws",
    "defs": {
      "req.requirement": {
        "id": "req.requirement",
        "home": "ws",
        "group": "block",
        "name": "requirement",
        "body": "Something the system shall do, and how that is shown.",
